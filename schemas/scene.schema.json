{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miko Scene",
  "type": "object",
  "required": [
    "scene_id",
    "sequence",
    "duration",
    "location",
    "characters",
    "action",
    "image_prompt",
    "video_prompt"
  ],
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^SCENE-[0-9]{2,}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "location": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "string"
    },
    "dialogue": {
      "type": "string"
    },
    "narration": {
      "type": "string"
    },
    "image_prompt": {
      "type": "string"
    },
    "video_prompt": {
      "type": "string"
    },
    "reference_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "GENERATING",
        "READY",
        "REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    },
    "video_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "GENERATING",
        "READY",
        "REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    }
  }
}
